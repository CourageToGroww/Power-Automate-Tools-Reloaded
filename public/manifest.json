{
   "name": "M365 Workbench",
   "description": "Universal Microsoft 365 data bridge - captures tokens, browses service data, and exposes everything to Claude Code via MCP.",
   "version": "2.0",
   "manifest_version": 3,
   "icons": {
      "512": "icons/pa-tools-512.png",
      "256": "icons/pa-tools-256.png",
      "128": "icons/pa-tools-128.png",
      "48": "icons/pa-tools-48.png"
   },
   "permissions": [
      "activeTab",
      "webRequest",
      "tabs",
      "notifications",
      "nativeMessaging",
      "storage"
   ],
   "host_permissions": [
      "*://*.flow.microsoft.com/*",
      "*://*.make.powerautomate.com/*",
      "*://*.make.powerapps.com/*",
      "*://*.api.powerapps.com/*",
      "*://*.api.flow.microsoft.com/*",
      "*://*.api.powerautomate.com/*",
      "https://login.microsoftonline.com/*",
      "https://api.openai.com/*",
      "https://api.anthropic.com/*",
      "https://graph.microsoft.com/*",
      "https://*.sharepoint.com/*",
      "https://forms.office.com/*",
      "https://forms.microsoft.com/*",
      "https://intune.microsoft.com/*",
      "https://*.manage.microsoft.com/*",
      "https://admin.teams.microsoft.com/*",
      "https://*.office.com/*",
      "https://*.office365.com/*"
   ],
   "action": {
      "default_title": "M365 Workbench"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "matches": [
            "*://*.make.powerautomate.com/*",
            "*://*.flow.microsoft.com/*",
            "*://*.make.powerapps.com/*"
         ],
         "js": ["content-script-main.js"],
         "world": "MAIN",
         "run_at": "document_start"
      },
      {
         "matches": [
            "*://*.make.powerautomate.com/*",
            "*://*.flow.microsoft.com/*",
            "*://*.make.powerapps.com/*",
            "*://*.sharepoint.com/*",
            "https://forms.office.com/*",
            "https://forms.microsoft.com/*",
            "https://intune.microsoft.com/*",
            "https://portal.azure.com/*",
            "https://admin.microsoft.com/*",
            "https://admin.teams.microsoft.com/*"
         ],
         "js": ["content-script.js"],
         "run_at": "document_start"
      }
   ]
}
